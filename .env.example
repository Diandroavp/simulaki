# Banco de dados (PostgreSQL)
DATABASE_URL=postgres://usuario:senha@localhost:5432/simulaki

# Gateway de pagamento (preencher quando o provedor for escolhido)
PAYMENT_GATEWAY=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Estado piloto (sigla)
DEFAULT_STATE=AM

# App
APP_URL=http://localhost:3000
# E-mails (separados por vírgula) que viram administradores ao entrar
ADMIN_EMAILS=
# Login com Google (opcional; sem isso o botão não aparece)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pagamento: 'mock' só para desenvolvimento (bloqueado em produção)
PAYMENT_WEBHOOK_SECRET=

# Canvi (PAYMENT_GATEWAY=canvi). Credenciais ficam só aqui, nunca no código.
PAYMENT_GATEWAY=mock
CANVI_BASE_URL=https://gateway-homol.service-canvi.com.br
CANVI_CLIENT_ID=
CANVI_PRIVATE_KEY=
# Segredo (16+ caracteres aleatórios) que vai na URL do webhook: /api/webhooks/canvi/<segredo>
CANVI_WEBHOOK_SECRET=

# E-mail (recuperação de senha). Sem RESEND_API_KEY, em desenvolvimento o e-mail aparece no console.
RESEND_API_KEY=
EMAIL_FROM=Simulaki <nao-responda@simulaki.com>
# Cópia oculta (Cco) de todo e-mail enviado. Padrão: diandroavp@gmail.com. Deixe vazio para desligar; vários separados por vírgula.
EMAIL_BCC=
PRELAUNCH=0

# Beta: mostra a faixa "versão beta" no topo
BETA=0
# Mostra também as questões em rascunho em produção (só para o beta, enquanto a revisão não termina)
ALLOW_DRAFT_QUESTIONS=0
# Dados da empresa nos termos/privacidade/reembolso. LEGAL_REVIEWED=1 some o aviso "em revisão jurídica".
LEGAL_RAZAO_SOCIAL=
LEGAL_CNPJ=
LEGAL_ENDERECO=
LEGAL_EMAIL_SUPORTE=
LEGAL_EMAIL_ENCARREGADO=
LEGAL_FORO=
LEGAL_REVIEWED=0

# Lembretes por e-mail (cron diário em vercel.json). Desligados por padrão.
# Para ligar: REMINDERS_ENABLED=1 e CRON_SECRET com 16+ caracteres aleatórios (a Vercel envia o segredo ao cron).
REMINDERS_ENABLED=0
CRON_SECRET=

# Anúncios (AdSense). Deixe vazio para desligar. CLIENT = ca-pub-XXXXXXXXXXXXXXXX, SLOT = ID do bloco de anúncio.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
